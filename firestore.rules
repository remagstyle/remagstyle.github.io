rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.uid == '8VRjJBdsEfO8PLXGdrwjB4Xf1vz1';
    }

    function isAnonymous() {
      return signedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    match /accounts/{accountId} {
      // The ID is a high-entropy share token generated by the admin workspace.
      allow get: if true;
      allow list, create, update, delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow read: if isAdmin() || isAnonymous() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if signedIn();
      allow update: if isAdmin() || isAnonymous() || (signedIn() && resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /appointments/{appointmentId} {
      allow read, update, delete: if isAdmin();
      allow create: if signedIn();
    }
  }
}
