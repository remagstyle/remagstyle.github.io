rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.uid == 'x1fOQ89476YB1e7RPxGsYlTNWKi1';
    }

    // Payment fields may only be written by the admin or the payment Worker,
    // never by a client creating an order.
    function hasNoPaymentFields() {
      return !request.resource.data.keys().hasAny([
        'paymentAmount',
        'currency',
        'paymentStatus',
        'amountDue',
        'PaymentAmmount',
        'amountCurrency',
        'paidAmount',
        'paidCurrency',
        'paidAt',
        'paymentReference',
        'paystackTransactionId',
        'payment'
      ]);
    }

    // STEP 2 (terms): every new order must carry the acceptance record the pages send.
    function hasValidTerms() {
      let t = request.resource.data.termsAcceptance;
      return 'termsAcceptance' in request.resource.data
        && t is map
        && t.keys().hasOnly(['version', 'acceptedAt'])
        && t.keys().hasAll(['version', 'acceptedAt'])
        && t.version is string && t.version.size() <= 20
        && t.acceptedAt is string && t.acceptedAt.size() <= 40;
    }

    // STEP 3 (optional hardening): a new order always starts as "Received".
    function startsAsReceived() {
      return request.resource.data.status == 'Received'
        && request.resource.data.deliveryStatus == 'To be confirmed'
        && !request.resource.data.keys().hasAny(['adminMessage', 'cancelledAt']);
    }

    // STEP 3 (optional hardening): a client may only change status to "Cancelled".
    function clientStatusChangeOk() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return !changed.hasAny(['status', 'deliveryStatus'])
        || (request.resource.data.status == 'Cancelled'
            && request.resource.data.deliveryStatus == 'Cancelled');
    }

    match /accounts/{accountId} {
      allow get: if true;
      allow list, create, update, delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow get: if true;
      allow list: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);

      allow create: if
        hasNoPaymentFields() &&
        hasValidTerms() &&
        startsAsReceived() && (
          (
            !signedIn() &&
            request.resource.data.guestOrder == true &&
            request.resource.data.userId == null
          ) || (
            signedIn() &&
            request.resource.data.userId == request.auth.uid
          )
        );

      allow update: if
        isAdmin() || (
          signedIn() &&
          resource.data.userId == request.auth.uid &&
          clientStatusChangeOk() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status',
            'deliveryStatus',
            'cancelledAt',
            'clientReply',
            'clientReplyAt',
            'estimatedCompletionAt'
          ])
        ) || (
          !signedIn() &&
          resource.data.guestOrder == true &&
          resource.data.userId == null &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'clientReply',
            'clientReplyAt',
            'estimatedCompletionAt'
          ])
        );

      allow delete: if isAdmin();
    }

    match /appointments/{appointmentId} {
      allow read, update, delete: if isAdmin();

      allow create: if
        request.resource.data.keys().hasAll([
          'customerName',
          'customerEmail',
          'customerPhone',
          'message',
          'status',
          'createdAt'
        ]) &&
        request.resource.data.keys().hasOnly([
          'customerName',
          'customerEmail',
          'customerPhone',
          'message',
          'status',
          'createdAt'
        ]) &&
        request.resource.data.customerName is string &&
        request.resource.data.customerName.size() > 0 &&
        request.resource.data.customerName.size() <= 100 &&
        request.resource.data.customerEmail is string &&
        request.resource.data.customerEmail.size() > 0 &&
        request.resource.data.customerEmail.size() <= 254 &&
        request.resource.data.customerPhone is string &&
        request.resource.data.customerPhone.size() > 0 &&
        request.resource.data.customerPhone.size() <= 40 &&
        request.resource.data.message is string &&
        request.resource.data.message.size() <= 2000 &&
        request.resource.data.status == 'New' &&
        request.resource.data.createdAt is timestamp;
    }

    match /users/{userId} {
      allow create: if signedIn() && request.auth.uid == userId;
      allow read, update: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow delete: if isAdmin();
    }

    // Website gallery. The public can read it; only the admin can change it.
    match /gallery/{itemId} {
      allow read: if true;
      allow create: if isAdmin()
        && request.resource.data.publicId is string
        && request.resource.data.publicId.matches('remagstyle-gallery/[a-f0-9]{32}')
        && request.resource.data.resourceType in ['image', 'video']
        && (
          !('collectionId' in request.resource.data)
          || request.resource.data.collectionId == null
          || request.resource.data.collectionId is string
        );
      allow update, delete: if isAdmin();
    }

    // NEW: gallery collections (for example Bridal, Evening). Public read; only the admin can change them.
    match /galleryCollections/{collectionId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40;
      allow delete: if isAdmin();
    }
  }
}